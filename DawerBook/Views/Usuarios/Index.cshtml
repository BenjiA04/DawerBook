@model IEnumerable<DawerBook.Models.Usuarios>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gestión de Usuarios</h2>
            <p>Administrador / Usuarios</p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Crear"
           class="btn btn-primary">
            + Nuevo Usuario
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Usuarios"
                  asp-action="Index"
                  method="get"
                  class="mb-3">

                <div class="input-group">
                    <input type="text"
                           name="buscar"
                           class="form-control"
                           placeholder="Buscar usuario..."
                           value="@Context.Request.Query["buscar"]" />

                    <button type="submit" class="btn btn-primary">
                        Buscar
                    </button>
                </div>
            </form>

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Exito"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Carnet</th>
                        <th>Correo electrónico</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.Id</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.Carnet</td>
                                <td>@usuario.Correo</td>

                                <td>
                                    <a asp-action="Editar"
                                       asp-route-id="@usuario.Id"
                                       class="btn btn-warning btn-sm">
                                        ✏️
                                    </a>

                                    <form asp-action="Eliminar"
                                          asp-route-id="@usuario.Id"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('¿Deseas eliminar este usuario?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            🗑️
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>