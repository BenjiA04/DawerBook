@model IEnumerable<DawerBook.Models.Prestamos>

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DawerBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f6f8fb;
            color: #1b2a41;
        }

        .panel {
            background: #fff;
            border: 1px solid #e3e8ef;
            border-radius: 12px;
            padding: 1.5rem;
        }

        .table thead th {
            background: #f1f4f9;
            font-size: .85rem;
            border-bottom: 0;
        }

        .badge-activo {
            background: #d9f2df;
            color: #1b7a34;
        }

        .badge-devuelto {
            background: #e6e9ef;
            color: #4a5568;
        }

        .btn-primary {
            background: #0b3d91;
            border-color: #0b3d91;
        }

        .btn-devolver {
            background: #e3ecfb;
            color: #0b3d91;
            border: 0;
        }

            .btn-devolver:hover {
                background: #d2e1f8;
                color: #0b3d91;
            }
    </style>
</head>
<body>
    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Gestión de Préstamos</h1>
            <a asp-action="Crear" class="btn btn-primary">+ Registrar préstamo</a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <div class="panel">
            <h2 class="h5 fw-bold mb-0">Préstamos registrados</h2>
            <p class="text-muted mb-3">Libros prestados y su estado actual.</p>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Libros</th>
                            <th class="text-center">Fecha de préstamo</th>
                            <th class="text-center">Fecha de devolución</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td>@p.Usuario.Nombre</td>
                                <td>
                                    @foreach (var d in p.Detalles)
                                    {
                                        <div>
                                            @d.Libro.Titulo
                                            @if (d.Fecha_Devuelto != null)
                                            {
                                                <small class="text-muted">(devuelto el @d.Fecha_Devuelto.Value.ToString("dd/MM/yyyy"))</small>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-center">@p.Fecha_Prestamo.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@p.Fecha_Devolucion.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge @(p.Estado == "Activo" ? "badge-activo" : "badge-devuelto")">@p.Estado</span>
                                </td>
                                <td class="text-center">
                                    @if (p.Estado == "Activo")
                                    {
                                        <form asp-action="Devolver" asp-route-id="@p.Id" method="post"
                                              onsubmit="return confirm('¿Registrar la devolución de este préstamo?');">
                                            <button type="submit" class="btn btn-sm btn-devolver">Registrar devolución</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No hay préstamos registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
