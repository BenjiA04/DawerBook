@model IEnumerable<DawerBook.Models.Prestamos>

@{
    ViewData["Title"] = "Gestión de Préstamos";
    var total = Model.Count();
}

<link rel="stylesheet" href="~/css/estilos.css" />

<!-- ENCABEZADO -->
<div class="dawer-hero p-4 p-md-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-1">DawerBook</h1>
            <p class="mb-0 opacity-75">Sistema de gestión de libros &middot; Listado de préstamos registrados</p>
        </div>
        <a asp-action="Crear" class="btn btn-light fw-semibold">
            + Registrar préstamo
        </a>
    </div>
</div>

<!-- MENSAJES (los envía el controlador con TempData) -->
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card dawer-card">
    <div class="card-body p-3 p-md-4">

        <!-- ENCABEZADO DE LA TABLA + CONTADOR -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <h5 class="fw-bold mb-1">Préstamos registrados</h5>
                <p class="text-muted mb-0">Libros prestados y su estado actual.</p>
            </div>

            <span class="text-muted">
                <strong>@total</strong> @(total == 1 ? "préstamo" : "préstamos")
            </span>
        </div>

        @if (total == 0)
        {
            <!-- SIN RESULTADOS -->
            <div class="text-center py-5">
                <h5 class="mb-1">No hay préstamos para mostrar</h5>
                <p class="text-muted mb-3">
                    Todavía no se ha registrado ningún préstamo.
                </p>
                <a asp-action="Crear" class="btn btn-primary">
                    Registrar el primer préstamo
                </a>
            </div>
        }
        else
        {
            <!-- TABLA DE PRÉSTAMOS -->
            <div class="table-responsive">
                <table class="table dawer-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Libros</th>
                            <th class="text-center">Fecha de préstamo</th>
                            <th class="text-center">Fecha de devolución</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="text-muted">@p.Id</td>

                                <td class="fw-semibold">@p.Usuario.Nombre</td>

                                <td>
                                    @foreach (var d in p.Detalles)
                                    {
                                        <div>
                                            @d.Libro.Titulo

                                            @if (d.Fecha_Devuelto != null)
                                            {
                                                <small class="text-muted">
                                                    (devuelto el @d.Fecha_Devuelto.Value.ToString("dd/MM/yyyy"))
                                                </small>
                                            }
                                        </div>
                                    }
                                </td>

                                <td class="text-center">
                                    @p.Fecha_Prestamo.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    @p.Fecha_Devolucion.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    @if (p.Estado == "Activo")
                                    {
                                        <span class="badge text-bg-success">
                                            @p.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @p.Estado
                                        </span>
                                    }
                                </td>

                                <td class="text-end text-nowrap">
                                    @if (p.Estado == "Activo")
                                    {
                                        <form asp-action="Devolver"
                                              asp-route-id="@p.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Registrar la devolución de este préstamo?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">
                                                Registrar devolución
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
