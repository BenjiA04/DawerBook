@model IEnumerable<Libros>

@{
    ViewData["Title"] = "Libros";
    var buscar = Context.Request.Query["buscar"].ToString();
    var total = Model.Count();
}

<link rel="stylesheet" href="~/css/estilos.css" />

<!-- ENCABEZADO -->
<div class="dawer-hero p-4 p-md-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-1">DawerBook</h1>
            <p class="mb-0 opacity-75">Sistema de gestión de libros &middot; Listado de libros registrados</p>
        </div>
        <a asp-controller="Libros" asp-action="Crear" class="btn btn-light fw-semibold">
            + Nuevo libro
        </a>
    </div>
</div>

<!-- MENSAJES (los envía el controlador con TempData) -->
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card dawer-card">
    <div class="card-body p-3 p-md-4">

        <!-- BUSCADOR + CONTADOR -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <form asp-controller="Libros" asp-action="Index" method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 480px;">
                <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por título..." />
                <button type="submit" class="btn btn-primary">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(buscar))
                {
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                }
            </form>

            <span class="text-muted">
                <strong>@total</strong> @(total == 1 ? "libro" : "libros")
                @if (!string.IsNullOrWhiteSpace(buscar))
                {
                    <span>para "@buscar"</span>
                }
            </span>
        </div>

        @if (total == 0)
        {
            <!-- SIN RESULTADOS -->
            <div class="text-center py-5">
                <h5 class="mb-1">No hay libros para mostrar</h5>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(buscar))
                    {
                        <span>No se encontró ningún libro con ese título.</span>
                    }
                    else
                    {
                        <span>Todavía no se ha registrado ningún libro.</span>
                    }
                </p>
                <a asp-controller="Libros" asp-action="Crear" class="btn btn-primary">Registrar el primer libro</a>
            </div>
        }
        else
        {
            <!-- TABLA DE LIBROS -->
            <div class="table-responsive">
                <table class="table dawer-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Género</th>
                            <th class="text-center">Cantidad</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var libro in Model)
                        {
                            <tr>
                                <td class="text-muted">@libro.Id</td>
                                <td class="fw-semibold">@libro.Titulo</td>
                                <td>@libro.Autor</td>
                                <td>@libro.Genero</td>
                                <td class="text-center">
                                    <span class="badge rounded-pill text-bg-light border">@libro.Cantidad</span>
                                </td>
                                <td>
                                    <span class="badge text-bg-secondary">@libro.Estado</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-controller="Libros" asp-action="Editar" asp-route-id="@libro.Id"
                                       class="btn btn-sm btn-outline-primary">Editar</a>

                                    <form asp-controller="Libros" asp-action="Eliminar" asp-route-id="@libro.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar este libro?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
