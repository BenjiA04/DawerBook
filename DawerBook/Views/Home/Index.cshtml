@model DawerBook.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Inicio";
    var nombre = User.Identity?.Name ?? "Visitante";
}

<link rel="stylesheet" href="~/css/estilos.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- ENCABEZADO -->
<div class="dawer-hero p-4 p-md-5 mb-4">
    <div>
        <h1 class="display-6 fw-bold mb-1">
            Bienvenido, @nombre
        </h1>

        <p class="mb-0 opacity-75">
            Aquí tienes un resumen general de la biblioteca.
        </p>
    </div>
</div>

<!-- TARJETAS ESTADÍSTICAS -->
<div class="row g-3 mb-4">

    <!-- LIBROS REGISTRADOS -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dawer-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">

                <div class="bg-primary-subtle text-primary rounded-3 p-3">
                    <i class="bi bi-book fs-3"></i>
                </div>

                <div>
                    <small class="text-muted">Libros registrados</small>
                    <h2 class="fw-bold mb-0">@Model.TotalLibros</h2>
                </div>

            </div>
        </div>
    </div>

    <!-- USUARIOS REGISTRADOS -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dawer-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">

                <div class="bg-primary-subtle text-primary rounded-3 p-3">
                    <i class="bi bi-people fs-3"></i>
                </div>

                <div>
                    <small class="text-muted">Usuarios registrados</small>
                    <h2 class="fw-bold mb-0">@Model.TotalUsuarios</h2>
                </div>

            </div>
        </div>
    </div>

    <!-- PRÉSTAMOS ACTIVOS -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dawer-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">

                <div class="bg-primary-subtle text-primary rounded-3 p-3">
                    <i class="bi bi-arrow-left-right fs-3"></i>
                </div>

                <div>
                    <small class="text-muted">Préstamos activos</small>
                    <h2 class="fw-bold mb-0">@Model.PrestamosActivos</h2>
                </div>

            </div>
        </div>
    </div>

    <!-- LIBROS DISPONIBLES -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dawer-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">

                <div class="bg-primary-subtle text-primary rounded-3 p-3">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>

                <div>
                    <small class="text-muted">Libros disponibles</small>
                    <h2 class="fw-bold mb-0">@Model.LibrosDisponibles</h2>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- CONTENIDO INFERIOR -->
<div class="row g-4">

    <!-- PRÉSTAMOS RECIENTES -->
    <div class="col-12 col-xl-7">
        <div class="card dawer-card h-100">
            <div class="card-body p-3 p-md-4">

                <h5 class="fw-bold mb-4">Préstamos recientes</h5>

                @if (!Model.PrestamosRecientes.Any())
                {
                    <div class="text-center py-5">
                        <h5 class="mb-1">No hay préstamos recientes</h5>
                        <p class="text-muted mb-0">
                            Todavía no se ha registrado ningún préstamo.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table dawer-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Libro</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var prestamo in Model.PrestamosRecientes)
                                {
                            <tr>
                                <td class="fw-semibold">
                                    @prestamo.Usuario.Nombre
                                </td>

                                <td>
                                    @string.Join(", ", prestamo.Detalles
                                                                        .Select(d => d.Libro.Titulo))
                                </td>

                                <td class="text-nowrap">
                                    @prestamo.Fecha_Prestamo.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge @(prestamo.Estado == "ACTIVO"
                                                                                                                                    ? "text-bg-success"
                                                                                                                                    : "text-bg-secondary")">

                                        @prestamo.Estado

                                            </span>
                                        </td>
                                    </tr>
                                                        }
                            </tbody>

                        </table>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- LIBROS POR GÉNERO -->
    <div class="col-12 col-xl-5">
        <div class="card dawer-card h-100">
            <div class="card-body p-3 p-md-4">

                <h5 class="fw-bold mb-4">Libros por género</h5>

                @if (Model.LibrosPorGenero.Any() && Model.TotalLibros > 0)
                {
                    <div class="position-relative" style="height: 270px;">

                        <canvas id="generosChart"
                                data-generos="@System.Text.Json.JsonSerializer.Serialize(
                                                                                                    Model.LibrosPorGenero.Select(g => g.Genero))"
                            data-cantidades="@System.Text.Json.JsonSerializer.Serialize(
                                                                                            Model.LibrosPorGenero.Select(g => g.Cantidad))">
                    </canvas>

                    </div>
                                }
                else
                {
                    <div class="text-center py-5">
                        <h5 class="mb-1">No hay libros registrados</h5>
                        <p class="text-muted mb-0">
                            No hay información para generar el gráfico.
                        </p>
                    </div>
                }

            </div>
        </div>
    </div>

</div>

<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>
